# Never commit real values. An empty deploy token refuses every write.
HESTIA_HOST=127.0.0.1
HESTIA_PORT=9480
HESTIA_PUBLIC_BASE=http://127.0.0.1:9480
HESTIA_DATA_DIR=./data
HESTIA_RUNTIME=stub
# Empty = SQLite under HESTIA_DATA_DIR (dev/test). Production: postgresql://…
# Dedicated `hestia` database — do not point this at Hub tables.
# HESTIA_DATABASE_URL=postgresql://hestia:…@hestia-postgres:5432/hestia
HESTIA_DATABASE_URL=
HESTIA_DEPLOY_TOKEN=
HESTIA_MAX_TENANTS=32
HESTIA_MAX_BODY_BYTES=262144
HESTIA_HUB_URL=
HESTIA_AUTO_ANNOUNCE=0
HESTIA_THEMIS_URL=
HESTIA_ADMIT_REVIEW=0
HESTIA_ALLOW_IMAGE_DIGESTS=
# Docker runtime: prefix of the per-tenant Internal networks (<prefix>-<slug>),
# and the private range their /29s come from. Ignored by the stub runtime.
HESTIA_TENANT_NETWORK=hestia-tenants
HESTIA_TENANT_SUBNET_POOL=10.231.0.0/16
# Compose stays stub. Docker runtime is a host process, not a sock in the box:
# HESTIA_RUNTIME=docker
# HESTIA_ALLOW_HOST_DOCKER=1
# HESTIA_DOCKER_RUNTIME=runsc   # fail closed if runsc is missing
# HESTIA_REQUIRE_GVISOR=1
# HESTIA_REQUIRE_SANDBOX=1      # refuses template-handler stub tenants
HESTIA_ALLOW_HOST_DOCKER=0
# Recorded only — not punched into tenant argv.
HESTIA_EGRESS_ALLOWLIST=modelmarket.dev,metis.modelmarket.dev
# Stub only: address-space ceiling (MiB) per tenant subprocess, on by default.
# 0 turns it off. Real CPU/memory limits are HESTIA_RUNTIME=docker. Core dumps
# are always disabled regardless.
HESTIA_STUB_MEMORY_CAP_MB=512
AIMARKET_PROVIDER_IDENTITY_FILE=./data/provider.key

# --- Payments (off by default) -------------------------------------------
# On, a priced tenant is only served after a USDC transfer to ITS OWN payout
# address is confirmed on chain. The hearth never holds the funds and takes no
# cut; enabling this without an RPC refuses to start rather than serving priced
# work for free.
HESTIA_PAYMENTS_ENABLED=0
HESTIA_PAYMENT_CHAIN=base
HESTIA_PAYMENT_TOKEN=USDC
HESTIA_PAYMENT_TOKEN_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
HESTIA_PAYMENT_RPC_URL=
HESTIA_PAYMENT_MIN_CONFIRMATIONS=1

# --- Verified compute (off by default; docs/COMPUTE.md) --------------------
# Buyers send data to a function you published; it runs in 1 (run) or 2 (verify)
# fresh subprocesses under rlimits and the answer is signed only when replicas
# agree. Never free when on: a hub key or a verified payment to a DEDICATED
# wallet (send nothing else there — that is what binds a payment to compute
# without a nonce of our own). Refuses to start when it could never be paid.
HESTIA_COMPUTE_ENABLED=0
# Slugs of running template tenants to publish as compute functions.
HESTIA_COMPUTE_FUNCTIONS=
HESTIA_COMPUTE_PAYOUT_ADDRESS=
# Same value as this hearth's entry in the hub's AIMARKET_PEER_API_KEYS (24+ chars).
HESTIA_COMPUTE_HUB_KEYS=
HESTIA_COMPUTE_CPU_MS=2000
HESTIA_COMPUTE_MEMORY_MB=256
HESTIA_COMPUTE_WALL_S=5
HESTIA_COMPUTE_MAX_CONCURRENT=2
HESTIA_COMPUTE_RUN_PRICE_USD=0.001
HESTIA_COMPUTE_VERIFY_PRICE_USD=0.0025
# Replicas are not a sandbox: HESTIA_REQUIRE_SANDBOX / prod refuse compute unless this is 1.
HESTIA_COMPUTE_ALLOW_UNSANDBOXED=0
