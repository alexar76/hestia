# Never commit real values. An empty deploy token refuses every write.
HESTIA_HOST=127.0.0.1
HESTIA_PORT=9480
HESTIA_PUBLIC_BASE=http://127.0.0.1:9480
HESTIA_DATA_DIR=./data
HESTIA_RUNTIME=stub
HESTIA_DEPLOY_TOKEN=
HESTIA_MAX_TENANTS=32
HESTIA_HUB_URL=
HESTIA_AUTO_ANNOUNCE=0
HESTIA_THEMIS_URL=
HESTIA_ADMIT_REVIEW=0
HESTIA_ALLOW_IMAGE_DIGESTS=
HESTIA_TENANT_NETWORK=hestia-tenants
# Compose stays stub. Docker runtime is a host process, not a sock in the box:
# HESTIA_RUNTIME=docker
# HESTIA_ALLOW_HOST_DOCKER=1
HESTIA_ALLOW_HOST_DOCKER=0
# Recorded only — not punched into tenant argv.
HESTIA_EGRESS_ALLOWLIST=modelmarket.dev,metis.modelmarket.dev
AIMARKET_PROVIDER_IDENTITY_FILE=./data/provider.key
